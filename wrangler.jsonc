{
  // Same Worker that already serves the site; this adds the live Q&A API on top.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "experiencia-comunica",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the API reaches the Worker code; every other path is served straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "QA_ROOM", "class_name": "QaRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QaRoom"] }],
  "observability": { "enabled": true }
}
